# Copy to .env and replace every placeholder. Never commit .env.
APP_DOMAIN=https://mcp.example.com

# Must exactly match the email claim emitted by the Auth0 Post-Login Action.
MCP_OAUTH_EMAIL_CLAIM=https://example.com/email

# Generate independent high-entropy values, for example: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
AUTH_ENCRYPTION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Bootstrap/control-plane credentials. Change immediately after first login.
PLATFORM_ADMIN_EMAIL=admin@example.invalid
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
PLATFORM_ADMIN_FULL_NAME=ContextForge Administrator

# Used only where the gateway provisions a default local user / Basic Auth.
# Do not reuse the admin password.
DEFAULT_USER_PASSWORD=REPLACE_WITH_A_UNIQUE_DEFAULT_USER_PASSWORD
BASIC_AUTH_PASSWORD=REPLACE_WITH_A_UNIQUE_BASIC_AUTH_PASSWORD
